# ─── Build (required) ────────────────────────────────────────────────────────
# Astro reads Supabase at BUILD time, not in the browser. Set these in Cloudflare
# Pages > Settings > Environment variables too, or the deployed build has no data.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ─── Scraper only (required for the cron) ────────────────────────────────────
# NEVER commit. Goes in GitHub Actions secrets. Bypasses RLS, so it can write.
SUPABASE_SERVICE_KEY=eyJ...

# ─── Site identity ───────────────────────────────────────────────────────────
# Absolute URLs in sitemap, RSS, canonicals and JobPosting schema.
# Wrong value here = wrong URLs submitted to Google. Set it before the first deploy.
SITE_URL=https://punehire.pages.dev
PUBLIC_CONTACT_EMAIL=hello@example.com

# ─── Analytics (optional, off until set) ─────────────────────────────────────
# GA4. Sets cookies, so it needs the consent notice already covered in /privacy/.
# PUBLIC_GA_ID=G-XXXXXXXXXX
# Cloudflare Web Analytics — cookieless alternative, no consent banner needed.
# PUBLIC_CF_BEACON=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AdSense (optional) ──────────────────────────────────────────────────────
# Only set this AFTER AdSense approves the site. Setting it early puts an unapproved
# ad script on every page and does nothing useful.
# PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# ─── Index push (optional, used by npm run ping) ─────────────────────────────
# Any 8-128 hex chars. Also served at /<key>.txt so IndexNow can verify ownership.
# PUBLIC_INDEXNOW_KEY=0123456789abcdef0123456789abcdef
# Service-account JSON, added as an owner in Search Console. Enables the Google
# Indexing API, which accepts JobPosting URLs directly instead of waiting for a crawl.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
