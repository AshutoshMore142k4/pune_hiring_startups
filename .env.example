# Build (Astro reads Supabase at BUILD time, not in the browser).
# Also set these in Cloudflare Pages > Settings > Environment variables.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Scraper only. NEVER commit. Goes in GitHub Actions secrets.
SUPABASE_SERVICE_KEY=eyJ...

# Absolute URLs in sitemap/RSS/schema. Defaults to the Pages subdomain.
SITE_URL=https://startup-radar.pages.dev

# Optional, for scripts/ping-index.ts. Unset = that channel is skipped, not an error.
# INDEXNOW_KEY=8-to-128-hex-chars-also-served-at-/<key>.txt
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
