---
import ContentShell from '../../layouts/ContentShell.astro'
import JobRows from '../../components/JobRows.astro'
import { byFunction } from '../../data/load'
import { collectionLd } from '../../data/seo'
import { jobSlug, slugify, url } from '../../data/slugs'
import { FUNCTIONS, type FunctionTag } from '@/lib/filters'

export async function getStaticPaths() {
  return Object.keys(FUNCTIONS).map((tag) => ({ params: { tag: slugify(tag) }, props: { tag } }))
}

const { tag } = Astro.props as { tag: FunctionTag }
const jobs = await byFunction(tag)

const LABELS: Record<string, string> = {
  engineering: 'Software engineering',
  'data/ai': 'Data and AI',
  product: 'Product',
  design: 'Design',
  'sales/gtm': 'Sales and go-to-market',
}
const label = LABELS[tag] ?? tag

const companies = [...new Set(jobs.map((j) => j.company.name))]
const h1 = `${label} jobs at Pune startups`
const description =
  `${jobs.length} open ${label.toLowerCase()} ${jobs.length === 1 ? 'role' : 'roles'} across ` +
  `${companies.length} Pune startups, taken straight from company job feeds and refreshed every six hours.`
---

<ContentShell
  title={`${h1} — ${jobs.length} open roles | Startup Radar`}
  description={description}
  path={url.role(tag)}
  h1={h1}
  lede={description}
  crumbs={[{ name: 'Roles', href: '/roles/' }, { name: label, href: url.role(tag) }]}
  jsonLd={[collectionLd(h1, description, jobs.map((j) => ({ name: j.title, href: url.job(jobSlug(j.company.slug, j.title, j.ats_job_id)) })), Astro.site)]}
>
  <JobRows jobs={jobs} />

  {companies.length > 0 && (
    <p class="small muted" style="margin-top:2em">
      Hiring for {label.toLowerCase()} right now: {companies.join(', ')}.
    </p>
  )}
</ContentShell>
