---
import ContentShell from '../../layouts/ContentShell.astro'
import { loadAll, type CompanyWithJobs } from '../../data/load'
import { collectionLd, organizationLd } from '../../data/seo'
import { jobSlug, url } from '../../data/slugs'
import { timeAgo } from '@/lib/filters'

export async function getStaticPaths() {
  const companies = await loadAll()
  return companies.map((company) => ({ params: { slug: company.slug }, props: { company } }))
}

const { company: c } = Astro.props as { company: CompanyWithJobs }

const all = await loadAll()
const neighbours = all
  .filter((o) => o.slug !== c.slug && o.area === c.area)
  .sort((a, b) => b.jobs.length - a.jobs.length)
  .slice(0, 6)

const hiring = c.jobs.length > 0
const title = hiring
  ? `${c.name} jobs in Pune — ${c.jobs.length} open ${c.jobs.length === 1 ? 'role' : 'roles'}`
  : `${c.name} — Pune startup careers`
const description = hiring
  ? `${c.jobs.length} open roles at ${c.name}${c.area ? ` in ${c.area}, Pune` : ' in Pune'}. ` +
    `${c.industry ?? 'Startup'}, ${c.headcount_band ?? 'growing team'}. Updated ${timeAgo(c.last_crawled_at)}.`
  : `${c.name} is a ${c.industry ?? 'startup'}${c.area ? ` in ${c.area}, Pune` : ' in Pune'}. ` +
    `No live feed yet — see their careers page for openings.`

const jsonLd = [
  organizationLd(c, Astro.site!),
  ...(hiring
    ? [
        collectionLd(
          `Open roles at ${c.name}`,
          description,
          c.jobs.map((j) => ({
            name: j.title,
            href: url.job(jobSlug(c.slug, j.title, j.ats_job_id)),
          })),
          Astro.site!,
        ),
      ]
    : []),
]
---

<ContentShell
  title={`${title} | Startup Radar`}
  description={description}
  path={url.company(c.slug)}
  h1={title}
  crumbs={[{ name: 'Startups', href: url.companies() }, { name: c.name, href: url.company(c.slug) }]}
  jsonLd={jsonLd}
>
  <dl class="factbox">
    {c.area && <div><dt>Area</dt><dd><a href={url.area(c.area)}>{c.area}</a>, Pune</dd></div>}
    {c.industry && <div><dt>Industry</dt><dd>{c.industry}</dd></div>}
    {c.headcount_band && <div><dt>Team size</dt><dd>{c.headcount_band}</dd></div>}
    {c.stage && <div><dt>Stage</dt><dd>{c.stage}</dd></div>}
    <div><dt>Listings checked</dt><dd>{timeAgo(c.last_crawled_at)}</dd></div>
  </dl>

  <p>
    {c.website && <a href={c.website} target="_blank" rel="noopener">Website &nearr;</a>}
    {c.website && c.careers_url && ' · '}
    {c.careers_url && <a href={c.careers_url} target="_blank" rel="noopener nofollow">Careers page &nearr;</a>}
  </p>

  {hiring ? (
    <>
      <h2 style="margin-top:1.6em">Open roles at {c.name}</h2>
      <div class="rows">
        {c.jobs.map((j) => (
          <a class="row" href={url.job(jobSlug(c.slug, j.title, j.ats_job_id))}>
            <span class="title">{j.title}</span>
            <span class="meta">
              {[j.location_raw, j.remote_type].filter(Boolean).join(' · ')}
            </span>
            <span class="at">seen {timeAgo(j.last_seen)}</span>
          </a>
        ))}
      </div>
    </>
  ) : (
    <>
      <h2 style="margin-top:1.6em">No live listings</h2>
      <p class="muted">
        {c.name} doesn't publish jobs through a feed we can read
        {c.ats ? '' : ' (their careers page is not on a supported ATS)'}, so openings aren't
        listed here. Their careers page above is the place to look.
      </p>
    </>
  )}

  {neighbours.length > 0 && (
    <>
      <h2 style="margin-top:2em">Other startups in {c.area}</h2>
      <div class="grid">
        {neighbours.map((o) => (
          <a class="tile" href={url.company(o.slug)}>
            <h3>{o.name}</h3>
            <span class="meta">{o.industry ?? 'Startup'}</span>
            <span class:list={['badge', o.jobs.length === 0 && 'is-idle']}>
              <span class:list={['dot', o.jobs.length === 0 && 'is-idle']}></span>
              {o.jobs.length ? `${o.jobs.length} open` : 'careers page'}
            </span>
          </a>
        ))}
      </div>
    </>
  )}
</ContentShell>
